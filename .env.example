# Server-only OpenRouter configuration. Never use NEXT_PUBLIC_ for this key.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
AGENTBORNE_MODEL=openai/gpt-5-mini

# The scripted provider is exclusively for deterministic automation. Normal
# interactive development must leave this unset so every turn uses OpenRouter.
# AGENTBORNE_PROVIDER=scripted

# Development-map center (Toledo, Ohio) and H3 resolution.
NEXT_PUBLIC_DEV_MAP_LATITUDE=41.6528
NEXT_PUBLIC_DEV_MAP_LONGITUDE=-83.5379
NEXT_PUBLIC_DEV_MAP_H3_RESOLUTION=9
